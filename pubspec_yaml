name: territorio_app
description: Gerenciador de território de congregação
publish_to: 'none'
version: 0.1.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # Estado
  flutter_riverpod: ^2.5.1

  # Banco local (offline-first)
  drift: ^2.18.0
  sqlite3_flutter_libs: ^0.5.20
  path_provider: ^2.1.3
  path: ^1.9.0

  # Backend / Sync
  supabase_flutter: ^2.5.0
  connectivity_plus: ^6.0.3

  # Mapas
  flutter_map: ^6.1.0
  latlong2: ^0.9.1

  # PDF (S-13)
  pdf: ^3.10.8
  printing: ^5.12.0

  # Utilidades
  intl: ^0.19.0
  uuid: ^4.4.0
  shared_preferences: ^2.2.3
  image_picker: ^1.1.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  drift_dev: ^2.18.0
  build_runner: ^2.4.9
  flutter_lints: ^4.0.0
